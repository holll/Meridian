# ============================================================
#  Meridian Relay — 配置示例
#  复制为 .env 后按实际情况修改
# ============================================================

# ── 服务监听 ──────────────────────────────────────────────
PORT=9091
PANEL_BIND_ADDR=0.0.0.0

# ── Master 连接 ───────────────────────────────────────────
# Master 面板地址（不带尾部斜杠）
MASTER_URL=https://panel.example.com

# 与 Master 的 RELAY_TOKEN 完全一致
RELAY_TOKEN=change-me-to-a-long-random-relay-secret

# ── 节点标识 ──────────────────────────────────────────────
# 全局唯一，用作 Master relay_nodes 表的主键
RELAY_NAME=Zouter-HK

# 运营商标识，可选，用于面板按运营商分组展示
# 常用值: telecom / unicom / mobile / hk / oversea
RELAY_ISP=hk

# ── 注意 ──────────────────────────────────────────────────
# ROUTE_PREFIX 无需配置，Relay 启动时自动从 Master 拉取
# ACCESS_LOG / DB_PATH / JWT_SECRET 均不适用于 Relay
