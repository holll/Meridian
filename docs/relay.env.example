# ============================================================
#  Meridian Relay — 配置示例
#  复制为 .env 后按实际情况修改
# ============================================================

# ── 服务监听 ──────────────────────────────────────────────
PORT=9091
PANEL_BIND_ADDR=0.0.0.0

# ── Master 连接 ───────────────────────────────────────────
# Master 面板地址（不带尾部斜杠）
MASTER_URL=https://panel.example.com

# 与 Master 的 RELAY_TOKEN 完全一致
RELAY_TOKEN=change-me-to-a-long-random-relay-secret

# ── 节点标识 ──────────────────────────────────────────────
# 全局唯一，用作 Master relay_nodes 表的主键
RELAY_NAME=Zouter-HK

# 运营商标识（可选）。Master 已启用 GeoLite 时会根据节点公网 IP 自动识别
# （telecom / unicom / mobile / hk / oversea），可留空不填
# RELAY_ISP=hk

# ── 访问日志上报 ──────────────────────────────────────────
# 是否将逐请求访问日志上报给 Master（默认开启，设为 0 关闭）
ACCESS_LOG_REPORT=1

# 可信反向代理网段（逗号分隔）。Relay 部署在 Nginx/CDN 后时配置此项，
# 访问日志将取 X-Real-IP / X-Forwarded-For 中的真实客户端 IP；不配置则记录对端地址
TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8,::1/128   # 支持 IPv6（如 ::1/128）

# ── 注意 ──────────────────────────────────────────────────
# ROUTE_PREFIX 无需配置，Relay 启动时自动从 Master 拉取
# ACCESS_LOG / DB_PATH / JWT_SECRET 均不适用于 Relay
#
# install-relay.sh 也支持以环境变量方式直接传入以上配置实现非交互安装
# （Master 节点管理页「复制安装命令」按钮可一键生成完整命令）：
#   env MASTER_URL=https://panel.example.com RELAY_TOKEN=xxx RELAY_NAME=my-node \
#       ./install-relay.sh install
