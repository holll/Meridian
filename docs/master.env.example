# ============================================================
#  Meridian Master — 配置示例
#  复制为 .env 后按实际情况修改，通过 systemd / Docker 等注入
# ============================================================

# ── 服务监听 ──────────────────────────────────────────────
PORT=9090
PANEL_BIND_ADDR=0.0.0.0        # 生产建议改为内网IP或127.0.0.1+反代

# ── 数据库 ────────────────────────────────────────────────
DB_PATH=/var/lib/meridian/meridian.db

# ── 路由前缀 ──────────────────────────────────────────────
# 所有代理站点路径的公共前缀，Relay 会从 Master 自动拉取，无需单独配置
ROUTE_PREFIX=/s

# ── 认证 ──────────────────────────────────────────────────
# JWT 签名密钥，至少 32 字节随机串，不设则每次重启失效
# 生成命令: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# ── 首次初始化 ────────────────────────────────────────────
# 首次启动时的管理员设置 Token，设置完成后可删除此变量
# 不设则自动生成并打印到日志
# SETUP_TOKEN=your-one-time-setup-token

# ── Relay API ─────────────────────────────────────────────
# Relay 节点与 Master 通信的共享密钥，至少 32 字节随机串
# 不设则 Relay API 禁用（/api/relay/* 返回 503）
# 生成命令: openssl rand -base64 48
RELAY_TOKEN=change-me-to-a-long-random-relay-secret

# ── 访问日志 ──────────────────────────────────────────────
ACCESS_LOG=/var/log/meridian/access.log

# ── 反向代理信任 ──────────────────────────────────────────
# 位于 Nginx/Caddy 后面时填写代理服务器 CIDR，逗号分隔
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8

# ── IP 归属识别（GeoLite2）────────────────────────────────
# 面板访问日志/分析页展示客户端 IP 的国家、城市与运营商。
# 默认加载二进制同目录下的 GeoLite2-City.mmdb + GeoLite2-ASN.mmdb，
# 缺失时自动从 GitHub 镜像下载；GEOLITE_DB_DIR 可指定其他目录，
# GEOLITE_DISABLE=1 可完全关闭（不下载）
# GEOLITE_DB_DIR=/var/lib/meridian/geolite
# GEOLITE_DISABLE=0
